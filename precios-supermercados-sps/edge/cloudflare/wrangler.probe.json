{
  "name": "precios-sps-controlled-probe",
  "main": "src/probe-worker.mjs",
  "compatibility_date": "2026-08-21",
  "preview_urls": false,
  "observability": {
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROBE_LEDGER",
        "class_name": "ProbeLedger"
      }
    ]
  },
  "exports": {
    "ProbeLedger": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "secrets": {
    "required": [
      "PROBE_RECEIPT_PRIVATE_KEY_PKCS8_B64URL",
      "PROBE_RECEIPT_PUBLIC_KEY_SPKI_B64URL",
      "PROBE_ORIGIN_URL"
    ]
  }
}
